# ---- Development -------------------------------------------------------------

# PostgreSQL connection string for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noteflow?schema=public"

# Direct (non-pooled) connection string. Prisma uses this for migrations and
# transactions. In development this is the same local database as above.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/noteflow?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Public base URL of the app (required in production)
AUTH_URL="http://localhost:3000"

# ---- Production (set these in the host, NEVER in this file or in git) --------
#
# DEP-001: create a hosted PostgreSQL (Neon, Supabase or Railway) in the region
# closest to your users.
#   - DATABASE_URL    = the pooled connection string (serverless functions open
#                       many short-lived connections through it)
#   - DIRECT_URL      = the direct connection string, used by `prisma migrate deploy`
#   - AUTH_SECRET     = a fresh secret per environment, generated with `npx auth secret`
#                       — never reuse the development value
#   - AUTH_URL        = the public production URL, e.g. https://noteflow.app
#
# Apply migrations against production with `prisma migrate deploy`, never
# `migrate dev`:
#
#   DIRECT_URL="$PROD_DIRECT_URL" npx prisma migrate deploy